# Used by `next dev` only. Browser + server components call the deployed API.
# Override with `.env.development.local` when you run the stack fully local (skip this file).

NEXT_PUBLIC_API_URL=https://fleet-nexus-ekc3.onrender.com/api
NEXT_PUBLIC_SOCKET_URL=https://fleet-nexus-ekc3.onrender.com/leads
API_INTERNAL_URL=https://fleet-nexus-ekc3.onrender.com/api

# Optional but needed for middleware-protected routes: same value as Render `JWT_ACCESS_SECRET`.
# Prefer setting in `.env.local` so it stays uncommitted — see `.env.example`.
# JWT_ACCESS_SECRET=
