# ─── Marketing site (this app, :3000) + legacy CRM (Vite, :8080). Staff sign-in goes to CRM. ───
NEXT_PUBLIC_CRM_URL=http://localhost:8080

# ─── Default: same-origin `/api`; Next.js rewrites to your API (next.config.mjs). ─────────
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://localhost:4000/api

# Local client → realtime (when API runs on your machine).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000/leads

# Optional — only if you add server-side auth on marketing routes later.
# JWT_ACCESS_SECRET="same-value-as-api-JWT_ACCESS_SECRET"

# ─── Alternative: bypass rewrite and hit Render/Vercel API directly (see `.env.development`). ─────
#
# NEXT_PUBLIC_API_URL=https://fleet-nexus-ekc3.onrender.com/api
# NEXT_PUBLIC_SOCKET_URL=https://fleet-nexus-ekc3.onrender.com/leads
# API_INTERNAL_URL=https://fleet-nexus-ekc3.onrender.com/api
#
# Backend must allow origin `http://localhost:3000` in `WEB_ORIGIN` when testing from `next dev`
# unless you rely on Render’s fallback allowlist that already includes localhost:3000.

# Google Ads tag ID (gtag.js, AW-…). Set in production env for live tracking.
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-11460691521

# Click-to-call number for /call marketing landing page and hero CTAs (E.164).
# Example: +12138550447
NEXT_PUBLIC_DIRECT_CALL_PHONE=
# Or set DIRECT_CALL_PHONE_NUMBER in src/modules/landing/lib/constants.ts
# Or edit DIRECT_CALL_PHONE_NUMBER in src/modules/landing/lib/constants.ts
