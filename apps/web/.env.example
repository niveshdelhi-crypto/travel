# ─── Default: SPA uses same-origin `/api`; Next.js rewrites to your API (next.config.mjs). ─────────
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://localhost:4000/api

# Local client → realtime (when API runs on your machine).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000/leads

# Optional: middleware route protection verifies JWT locally.
JWT_ACCESS_SECRET="same-value-as-api-JWT_ACCESS_SECRET-for-middleware-verification"

# ─── Alternative: bypass rewrite and hit Render/Vercel API directly (see `.env.development`). ─────
#
# NEXT_PUBLIC_API_URL=https://fleet-nexus-ekc3.onrender.com/api
# NEXT_PUBLIC_SOCKET_URL=https://fleet-nexus-ekc3.onrender.com/leads
# API_INTERNAL_URL=https://fleet-nexus-ekc3.onrender.com/api
#
# Backend must allow origin `http://localhost:3000` in `WEB_ORIGIN` when testing from `next dev`
# unless you rely on Render’s fallback allowlist that already includes localhost:3000.
