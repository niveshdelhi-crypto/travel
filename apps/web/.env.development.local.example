# Copy to `.env.development.local` (gitignored) to override local defaults.

# --- Remote API only (no local NestJS) ---
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com/api
# NEXT_PUBLIC_SOCKET_URL=https://your-api.onrender.com/leads
# API_INTERNAL_URL=https://your-api.onrender.com/api

# --- JWT (required for protected routes in middleware) ---
# Copy the exact value from apps/api/.env
# JWT_ACCESS_SECRET=your-api-jwt-access-secret
