# Local Postgres (recommended for offline dev):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fleetnexus?schema=public"

# Neon (cloud): copy from Neon dashboard → Connection string → Pooled.
# Use sslmode=require only — do NOT add channel_binding=require (breaks Prisma on Windows).
# Example:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=60&pool_timeout=30&connection_limit=5"

# Comma-separated browser origins allowed for CORS (must include every hostname used for the SPA).
WEB_ORIGIN="http://localhost:8080,http://localhost:8081,http://localhost:3000"

# Convenience for Vercel: when set to true, also permit any https://*.vercel.app (preview + *.vercel.app production).
# For a custom domain (e.g. app.example.com), list it explicitly in WEB_ORIGIN instead.
# WEB_ORIGIN_ALLOW_VERCEL_PREVIEW=false

# Convenience for multiple Render-hosted apps (HTTPS): when true, permit any https://*.onrender.com for CORS + Socket.IO.
# Prefer WEB_ORIGIN with your frontend URL(s); use this only if the SPA hostname is on *.onrender.com and not listed elsewhere.
# WEB_ORIGIN_ALLOW_RENDER_PREVIEW=false

PORT=4000

# Dev-only: faster Neon retries (production always uses 20 × 3s). API listens before DB is warm.
# PRISMA_CONNECT_MAX_ATTEMPTS=6
# PRISMA_CONNECT_RETRY_MS=1000

# Express trust proxy (hop count). Use 1 on Render/production so cookie Host / secure flags follow X-Forwarded-* from edge proxies (e.g. Vercel `/api` rewrites).
# TRUST_PROXY_HOPS=1

JWT_ACCESS_SECRET="replace-with-strong-access-secret"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret"

# Auth cookie/session tuning (see AuthService cookieConfig).
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECURE=false

# Optional: restrict cookie domain in prod (e.g. ".yourdomain.com").
# COOKIE_DOMAIN=

# SameSite for auth/csrf cookies. Use `none` when the SPA hostname differs from the API
# (e.g. Vercel → Render): requires HTTPS; browsers deny `none` without Secure cookies.
# COOKIE_SAME_SITE=lax
# COOKIE_SAME_SITE=none

# ─── Redis (production / multi-instance API) ───────────────────────────────
# When set to a real URL (not empty, not YOUR_* placeholder), Nest enables:
#   • @socket.io/redis-adapter — shared Socket.IO rooms across API replicas
#   • Redis-backed realtime event deduplication
# Use redis://… or rediss://… if your provider requires TLS (Redis Cloud often documents both).
REDIS_URL=

# ─── Telnyx Call Control (primary inbound CRM entry) ─────────────────────
TELNYX_API_KEY=
# Ed25519 public key from Telnyx Mission Control → API Keys (webhook verification)
TELNYX_PUBLIC_KEY=
# Call Control connection ID for bridging answered inbound calls
TELNYX_CONNECTION_ID=
# E.164 number presented on outbound / fallback caller ID
TELNYX_DEFAULT_FROM_NUMBER=
# true | false — defaults to true when NODE_ENV=production
# TELNYX_WEBHOOK_SIGNATURE_REQUIRED=true
# Comma-separated IPs allowed to POST /api/calls/webhooks/telnyx (empty = allow all)
# TELNYX_WEBHOOK_IP_ALLOWLIST=
# TELNYX_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
# Configure Telnyx Call Control webhook URL: {PUBLIC_API_BASE_URL}/api/calls/webhooks/telnyx

# ─── Vonage Voice API (legacy outbound / optional) ───────────────────────
# Required for outbound calling and webhook-driven state. Leave unset to disable
# Vonage client initialization (outbound returns 503; webhooks still persist events).
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=
# Optional override for Vonage REST API host (default: https://api.nexmo.com)
VONAGE_BASE_URL=
# E.164 number used as caller ID for outbound calls when from_number is omitted
VONAGE_DEFAULT_FROM_NUMBER=

# Public HTTPS base URL of this API (no trailing slash), used to build Vonage webhook URLs
# Example: https://api.yourdomain.com
PUBLIC_API_BASE_URL=

# Vonage signed webhook verification (required in production)
VONAGE_SIGNATURE_SECRET=
# true | false — defaults to true when NODE_ENV=production
# VONAGE_WEBHOOK_SIGNATURE_REQUIRED=true
# Comma-separated IPs allowed to call /api/calls/webhooks/* (empty = allow all)
# VONAGE_WEBHOOK_IP_ALLOWLIST=
# Seconds of clock skew tolerance for webhook JWT iat (default 300)
# VONAGE_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# ─── Payment orchestration ─────────────────────────────────────────────────
# AES-256-GCM key for encrypting payment gateway credentials at rest.
# Use 64-char hex or base64-encoded 32-byte key. Required in production.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=

# PayPal sandbox app credentials (Developer Dashboard → Sandbox app).
# Sync into payment_gateways with: npm run sync:paypal-credentials
# PAYPAL_SANDBOX_CLIENT_ID=
# PAYPAL_SANDBOX_CLIENT_SECRET=

# Optional: PayPal webhooks (Developer Dashboard → Webhooks → Add webhook).
# URL: {PUBLIC_API_BASE_URL}/api/payments/webhooks/paypal
# Events: CHECKOUT.ORDER.COMPLETED, PAYMENT.CAPTURE.COMPLETED
# Copy the Webhook ID shown after creation:
# PAYPAL_WEBHOOK_ID=
