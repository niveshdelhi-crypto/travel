DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fleetnexus?schema=public"

# Comma-separated browser origins allowed for CORS (must include every hostname used for the SPA).
WEB_ORIGIN="http://localhost:8080,http://localhost:3000"

# Convenience for Vercel: when set to true, also permit any https://*.vercel.app (preview + *.vercel.app production).
# For a custom domain (e.g. app.example.com), list it explicitly in WEB_ORIGIN instead.
# WEB_ORIGIN_ALLOW_VERCEL_PREVIEW=false

# Convenience for multiple Render-hosted apps (HTTPS): when true, permit any https://*.onrender.com for CORS + Socket.IO.
# Prefer WEB_ORIGIN with your frontend URL(s); use this only if the SPA hostname is on *.onrender.com and not listed elsewhere.
# WEB_ORIGIN_ALLOW_RENDER_PREVIEW=false

PORT=4000

# Express trust proxy (hop count). Use 1 on Render/production so cookie Host / secure flags follow X-Forwarded-* from edge proxies (e.g. Vercel `/api` rewrites).
# TRUST_PROXY_HOPS=1

JWT_ACCESS_SECRET="replace-with-strong-access-secret"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret"

# Auth cookie/session tuning (see AuthService cookieConfig).
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECURE=false

# Optional: restrict cookie domain in prod (e.g. ".yourdomain.com").
# COOKIE_DOMAIN=

# SameSite for auth/csrf cookies. Use `none` when the SPA hostname differs from the API
# (e.g. Vercel → Render): requires HTTPS; browsers deny `none` without Secure cookies.
# COOKIE_SAME_SITE=lax
# COOKIE_SAME_SITE=none

# ─── Redis (production / multi-instance API) ───────────────────────────────
# When set to a real URL (not empty, not YOUR_* placeholder), Nest enables:
#   • @socket.io/redis-adapter — shared Socket.IO rooms across API replicas
#   • Redis-backed realtime event deduplication
# Use redis://… or rediss://… if your provider requires TLS (Redis Cloud often documents both).
REDIS_URL=
