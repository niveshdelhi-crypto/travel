# Root Vite app (TanStack SPA in `src/`) — set in Vercel → Environment Variables — Production.
#
# Builds inline `import.meta.env.VITE_*`. This repo’s vercel.json rewrites `/api/*` → Render so
# the default `/api` base works without committing secrets.

# Optional override (omit for same-origin /api → Render rewrite on Vercel):
# VITE_API_BASE_URL=https://fleet-nexus-ekc3.onrender.com/api

# Socket.IO connects to Nest directly — set on Vercel for realtime dashboards (cannot use SPA /api WS).
VITE_SOCKET_URL=https://fleet-nexus-ekc3.onrender.com/leads
